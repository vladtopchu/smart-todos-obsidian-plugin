{
  "name": "obsidian-dayline",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown-first planning, tasks, goals and habits for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "preview": "vite --host 127.0.0.1",
    "package": "npm run check && node scripts/package.mjs",
    "install-plugin": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
